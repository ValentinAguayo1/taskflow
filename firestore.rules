rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read: if isOwner();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'title', 'description', 'completed', 'createdAt', 'order', 'userId'
        ])
        && isValidTask(request.resource.data);

      allow update: if isOwner()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'completed', 'dueDate', 'order'])
        && isValidTask(request.resource.data);

      allow delete: if isOwner();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isValidTask(data) {
      return data.keys().hasOnly([
          'title', 'description', 'completed', 'createdAt', 'order', 'userId', 'dueDate'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.completed is bool
        && data.userId is string
        && data.userId.size() > 0
        && (!('description' in data)
          || (data.description is string && data.description.size() <= 2000))
        && (!('order' in data) || data.order is int)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('dueDate' in data) || isDueDate(data.dueDate));
    }

    function isDueDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
  }
}
